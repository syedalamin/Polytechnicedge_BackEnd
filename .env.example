version: '3.8'

services:
  postgres:
    image: postgres:16
    container_name: postgres
    restart: on-failure
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: polytechnicedge
    ports:
      - "5432:5432"
    volumes:
      - postgres:/var/lib/postgresql/data

  pgadmin:
    image: dpage/pgadmin4
    container_name: pgadmin
    restart: on-failure
    environment:
      PGADMIN_DEFAULT_EMAIL: admin@example.com
      PGADMIN_DEFAULT_PASSWORD: admin
    ports:
      - "5050:80"
      - "5051:443"
    depends_on:
      - postgres

  redis:
    image: redis:7
    container_name: redis
    restart: on-failure
    environment:
      REDIS_ARGS: "--save 900 1"
    ports:
      - "6379:6379"
    volumes:
      - redis:/var/lib/redis

  redisinsight:
    image: redis/redisinsight:latest
    container_name: redisinsight
    restart: on-failure
    ports:
      - "5540:5540"
    depends_on:
      - redis


  mailhog:
    image: mailhog/mailhog
    container_name: mailhog
    restart: on-failure
    ports:
      - '1025:1025'
      - '8025:8025'
    volumes:
      - mailhog:/var/lib/mailhog

volumes:
  postgres:
  redis:
  mailhog:

    # restart: on-failure
